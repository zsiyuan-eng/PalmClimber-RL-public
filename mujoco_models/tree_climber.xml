<mujoco model="tree_climber_body">
  <!--
    Palm Tree Climbing Robot - body only (no tree, no arm)
    Ring circumference = 1.2m  ->  outer_radius ~ 0.191m
    6x Dynamixel MX-28 wheels arranged every 60 deg
    Two clamping rings (upper/lower) connected by 4 vertical rails

    Coordinate convention: z=up (along tree), x/y = radial
    The robot body slides along a free joint in scene.xml
  -->

  <asset>
    <material name="frame_black"  rgba="0.08 0.08 0.08 1"/>
    <material name="frame_silver" rgba="0.7 0.7 0.75 1"/>
    <material name="wheel_blue"   rgba="0.12 0.25 0.72 1"/>
    <material name="rail_mat"     rgba="0.55 0.55 0.55 1"/>
  </asset>

  <worldbody>
    <body name="climber_root" pos="0 0 0.4">
      <!-- free joint lets the whole robot translate+rotate in scene.xml -->
      <freejoint name="climber_free"/>

      <!-- ── lower ring ── -->
      <body name="lower_ring" pos="0 0 0">
        <!-- approximate the ring as 8 small boxes arranged in a circle -->
        <geom name="lr_0"  type="box" size="0.06 0.015 0.012" pos=" 0.176  0.000 0" material="frame_black" mass="0.05"/>
        <geom name="lr_45" type="box" size="0.06 0.015 0.012" pos=" 0.124  0.124 0" euler="0 0  45" material="frame_black" mass="0.05"/>
        <geom name="lr_90" type="box" size="0.06 0.015 0.012" pos=" 0.000  0.176 0" euler="0 0  90" material="frame_black" mass="0.05"/>
        <geom name="lr_135"type="box" size="0.06 0.015 0.012" pos="-0.124  0.124 0" euler="0 0 135" material="frame_black" mass="0.05"/>
        <geom name="lr_180"type="box" size="0.06 0.015 0.012" pos="-0.176  0.000 0" euler="0 0 180" material="frame_black" mass="0.05"/>
        <geom name="lr_225"type="box" size="0.06 0.015 0.012" pos="-0.124 -0.124 0" euler="0 0 225" material="frame_black" mass="0.05"/>
        <geom name="lr_270"type="box" size="0.06 0.015 0.012" pos=" 0.000 -0.176 0" euler="0 0 270" material="frame_black" mass="0.05"/>
        <geom name="lr_315"type="box" size="0.06 0.015 0.012" pos=" 0.124 -0.124 0" euler="0 0 315" material="frame_black" mass="0.05"/>
      </body>

      <!-- ── upper ring ── -->
      <body name="upper_ring" pos="0 0 0.22">
        <geom name="ur_0"  type="box" size="0.06 0.015 0.012" pos=" 0.176  0.000 0" material="frame_black" mass="0.05"/>
        <geom name="ur_45" type="box" size="0.06 0.015 0.012" pos=" 0.124  0.124 0" euler="0 0  45" material="frame_black" mass="0.05"/>
        <geom name="ur_90" type="box" size="0.06 0.015 0.012" pos=" 0.000  0.176 0" euler="0 0  90" material="frame_black" mass="0.05"/>
        <geom name="ur_135"type="box" size="0.06 0.015 0.012" pos="-0.124  0.124 0" euler="0 0 135" material="frame_black" mass="0.05"/>
        <geom name="ur_180"type="box" size="0.06 0.015 0.012" pos="-0.176  0.000 0" euler="0 0 180" material="frame_black" mass="0.05"/>
        <geom name="ur_225"type="box" size="0.06 0.015 0.012" pos="-0.124 -0.124 0" euler="0 0 225" material="frame_black" mass="0.05"/>
        <geom name="ur_270"type="box" size="0.06 0.015 0.012" pos=" 0.000 -0.176 0" euler="0 0 270" material="frame_black" mass="0.05"/>
        <geom name="ur_315"type="box" size="0.06 0.015 0.012" pos=" 0.124 -0.124 0" euler="0 0 315" material="frame_black" mass="0.05"/>
      </body>

      <!-- ── 4 vertical connecting rails ── -->
      <geom name="rail_0"   type="box" size="0.008 0.008 0.11" pos=" 0.17  0.00 0.11" material="rail_mat" mass="0.04"/>
      <geom name="rail_90"  type="box" size="0.008 0.008 0.11" pos=" 0.00  0.17 0.11" material="rail_mat" mass="0.04"/>
      <geom name="rail_180" type="box" size="0.008 0.008 0.11" pos="-0.17  0.00 0.11" material="rail_mat" mass="0.04"/>
      <geom name="rail_270" type="box" size="0.008 0.008 0.11" pos=" 0.00 -0.17 0.11" material="rail_mat" mass="0.04"/>

      <!-- ── 6 Dynamixel wheel bodies, evenly spaced every 60 deg ──
           Wheels press inward from ring radius 0.191m toward tree at r=0.12m
           Wheel contact radius = 0.025m, so wheel center at r = 0.12 + 0.025 = 0.145m
           Lower ring: wheels 1,3,5  (z=0)
           Upper ring: wheels 2,4,6  (z=0.22)
      -->

      <!-- wheel 1  @ 0 deg, lower -->
      <body name="wheel1" pos="0.145 0.000 0.00">
        <joint name="wheel1_spin" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="wheel1_g" type="cylinder" size="0.025 0.018"
              euler="90 0 0" material="wheel_blue" mass="0.06" friction="1.2 0.01 0.01"/>
        <geom name="wheel1_hub" type="cylinder" size="0.012 0.010"
              euler="90 0 0" material="frame_black" mass="0.02"/>
      </body>

      <!-- wheel 2  @ 60 deg, upper -->
      <body name="wheel2" pos="0.0725 0.1255 0.22">
        <joint name="wheel2_spin" type="hinge" axis="-0.866 0.5 0" damping="0.02"/>
        <geom name="wheel2_g" type="cylinder" size="0.025 0.018"
              euler="90 60 0" material="wheel_blue" mass="0.06" friction="1.2 0.01 0.01"/>
        <geom name="wheel2_hub" type="cylinder" size="0.012 0.010"
              euler="90 60 0" material="frame_black" mass="0.02"/>
      </body>

      <!-- wheel 3  @ 120 deg, lower -->
      <body name="wheel3" pos="-0.0725 0.1255 0.00">
        <joint name="wheel3_spin" type="hinge" axis="-0.866 -0.5 0" damping="0.02"/>
        <geom name="wheel3_g" type="cylinder" size="0.025 0.018"
              euler="90 120 0" material="wheel_blue" mass="0.06" friction="1.2 0.01 0.01"/>
        <geom name="wheel3_hub" type="cylinder" size="0.012 0.010"
              euler="90 120 0" material="frame_black" mass="0.02"/>
      </body>

      <!-- wheel 4  @ 180 deg, upper -->
      <body name="wheel4" pos="-0.145 0.000 0.22">
        <joint name="wheel4_spin" type="hinge" axis="0 -1 0" damping="0.02"/>
        <geom name="wheel4_g" type="cylinder" size="0.025 0.018"
              euler="90 0 0" material="wheel_blue" mass="0.06" friction="1.2 0.01 0.01"/>
        <geom name="wheel4_hub" type="cylinder" size="0.012 0.010"
              euler="90 0 0" material="frame_black" mass="0.02"/>
      </body>

      <!-- wheel 5  @ 240 deg, lower -->
      <body name="wheel5" pos="-0.0725 -0.1255 0.00">
        <joint name="wheel5_spin" type="hinge" axis="0.866 -0.5 0" damping="0.02"/>
        <geom name="wheel5_g" type="cylinder" size="0.025 0.018"
              euler="90 240 0" material="wheel_blue" mass="0.06" friction="1.2 0.01 0.01"/>
        <geom name="wheel5_hub" type="cylinder" size="0.012 0.010"
              euler="90 240 0" material="frame_black" mass="0.02"/>
      </body>

      <!-- wheel 6  @ 300 deg, upper -->
      <body name="wheel6" pos="0.0725 -0.1255 0.22">
        <joint name="wheel6_spin" type="hinge" axis="0.866 0.5 0" damping="0.02"/>
        <geom name="wheel6_g" type="cylinder" size="0.025 0.018"
              euler="90 300 0" material="wheel_blue" mass="0.06" friction="1.2 0.01 0.01"/>
        <geom name="wheel6_hub" type="cylinder" size="0.012 0.010"
              euler="90 300 0" material="frame_black" mass="0.02"/>
      </body>

      <!-- mounting plate for arm on top -->
      <geom name="arm_mount_plate" type="box" size="0.05 0.05 0.008"
            pos="0 0 0.235" material="frame_silver" mass="0.08"/>

      <!-- IMU site (for reading tilt in simulation) -->
      <site name="imu_site" pos="0 0 0.11" size="0.005" rgba="1 1 0 1"/>
      <!-- CoM site -->
      <site name="com_site" pos="0 0 0.11" size="0.005" rgba="0 1 0 0.5"/>

    </body>
  </worldbody>

  <actuator>
    <!-- velocity actuators for each wheel, matching real Dynamixel velocity-mode control -->
    <velocity name="vel_wheel1" joint="wheel1_spin" kv="2.0" ctrlrange="-20 20"/>
    <velocity name="vel_wheel2" joint="wheel2_spin" kv="2.0" ctrlrange="-20 20"/>
    <velocity name="vel_wheel3" joint="wheel3_spin" kv="2.0" ctrlrange="-20 20"/>
    <velocity name="vel_wheel4" joint="wheel4_spin" kv="2.0" ctrlrange="-20 20"/>
    <velocity name="vel_wheel5" joint="wheel5_spin" kv="2.0" ctrlrange="-20 20"/>
    <velocity name="vel_wheel6" joint="wheel6_spin" kv="2.0" ctrlrange="-20 20"/>
  </actuator>

</mujoco>
